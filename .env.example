# ==========================================
# Equity Intelligence — Environment Config
# ==========================================
# Copy this file to .env before running docker compose up --build

# Application
APP_ENV=development
APP_NAME=Equity Intelligence
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=equity_user
POSTGRES_PASSWORD=equity_local_password
POSTGRES_DB=equity_intelligence

# Backend Database Connection (used by FastAPI & Alembic)
DATABASE_URL=postgresql+psycopg://equity_user:equity_local_password@db:5432/equity_intelligence

# Backend Server & Security
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_DIR=/app/storage
MAX_UPLOAD_SIZE_MB=50

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1

# Optional Market Data Providers (Keep secrets backend-only)
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_API_BASE_URL=https://api.upstox.com/v2
UPSTOX_RATE_LIMIT_PER_SEC=5
